{% extends 'default_frame.twig' %}

{% block title %}{{ 'data_migration_backup.admin.nav.scanner'|trans }}{% endblock %}
{% block sub_title %}{{ 'data_migration_backup.admin.nav.title'|trans }}{% endblock %}
{% set menus = ['data_migration_backup', 'data_migration_backup_scanner'] %}

{% block main %}
<div class="c-contentsArea__cols">
    <div class="c-contentsArea__primaryCol">
        <div class="card">
            <div class="card-header font-weight-bold">{{ 'data_migration_backup.admin.nav.scanner'|trans }}</div>
            <div class="card-body">
                <div class="alert alert-warning mb-4">
                    EC-CUBE 3 向けの事前診断画面は現在互換対応中です。
                </div>
                <p class="mb-3">先に以下の画面をご利用ください。</p>
                <div class="btn-group" role="group">
                    <a class="btn btn-ec-regular" href="{{ url('data_migration_backup_admin_index') }}">
                        {{ 'data_migration_backup.admin.nav.index'|trans }}
                    </a>
                    <a class="btn btn-ec-regular" href="{{ url('data_migration_backup_admin_files') }}">
                        {{ 'data_migration_backup.admin.nav.files'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
