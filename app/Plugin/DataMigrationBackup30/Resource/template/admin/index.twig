{% extends 'default_frame.twig' %}

{% block title %}{{ 'data_migration_backup.admin.nav.index'|trans }}{% endblock %}
{% block sub_title %}{{ 'data_migration_backup.admin.nav.title'|trans }}{% endblock %}
{% set menus = ['data_migration_backup', 'data_migration_backup_index'] %}

{% block stylesheet %}
<style>
    .dmb-admin-screen {
        font-size: 1.4rem;
        line-height: 1.6;
    }
    .dmb-admin-screen .box-header .box-title {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1.3;
    }
    .dmb-admin-screen .modal-header .modal-title {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.3;
    }
    .dmb-admin-screen .small,
    .dmb-admin-screen .btn,
    .dmb-admin-screen .form-control {
        font-size: 1.4rem;
    }
    .dmb-admin-screen table thead th {
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1.25;
    }
    .dmb-table-scroll {
        max-height: 260px;
        overflow: auto;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 10px;
        background: #fff;
    }
    .dmb-table-scroll label {
        white-space: normal;
        word-break: break-all;
        line-height: 1.35;
    }
    .dmb-progress-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .35);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1030;
    }
    .dmb-progress-panel {
        width: min(560px, calc(100% - 32px));
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .25);
        padding: 20px;
    }
    .dmb-progress-title {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 8px;
    }
    .dmb-progress-note {
        color: #4b5563;
        margin-bottom: 12px;
        font-size: 1.4rem;
    }
    .dmb-progress-wrap {
        position: relative;
        background: #eef0f3;
        border: 1px solid #d1d5db;
        border-radius: 999px;
        overflow: hidden;
    }
    #dmbProgressBar {
        background: #cbd0d8 !important;
        background-image: none !important;
    }
    .dmb-progress-percent {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #111827;
        font-size: 1.4rem;
        pointer-events: none;
        text-shadow: none;
    }
    .dmb-warning-inline {
        color: #b45309;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .dmb-modal-guide {
        margin: 10px 0 0;
        padding-left: 18px;
    }
    .dmb-download-item .dmb-download-status {
        display: none;
        color: #16a34a;
        margin-right: 0;
        line-height: 1;
        padding-top: 0;
        flex: 0 0 auto;
    }
    .dmb-download-item .dmb-download-status.is-done {
        display: inline-flex;
    }
    .dmb-download-title {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 700;
        font-size: 1.4rem;
        line-height: 1.35;
    }
    .dmb-download-name {
        display: inline-block;
    }
    .dmb-download-item {
        border: 1px solid #d2d6de;
        border-radius: 4px;
        padding: 10px;
        margin-bottom: 10px;
        overflow: hidden;
    }
    .dmb-download-main {
        overflow: hidden;
        margin-right: 10px;
    }
    .dmb-download-actions {
        float: right;
        margin-left: 10px;
    }
    .dmb-download-item:after {
        content: "";
        display: block;
        clear: both;
    }
    .dmb-label-status {
        display: inline-block;
        padding: .2em .6em .3em;
        font-size: 75%;
        font-weight: 700;
        color: #fff;
        border-radius: .25em;
    }
    .dmb-label-status-success {
        background: #00a65a;
    }
    .dmb-label-status-warning {
        background: #f39c12;
    }
    .w-100 {
        width: 100%;
    }
    .modal-backdrop {
        z-index: 1040 !important;
    }
    .modal {
        z-index: 1050 !important;
    }
    .modal.fade,
    .modal.fade .modal-dialog,
    .modal.fade .modal-content,
    .modal-backdrop.fade {
        transition: none !important;
        animation: none !important;
    }
    .modal.fade .modal-dialog {
        transform: none !important;
    }
    .modal-dialog {
        margin: 40px auto;
    }
    #dmbDoneModal.in,
    #dmbDoneModal.show {
        display: flex !important;
        align-items: center;
        justify-content: center;
        padding: 12px;
    }
    #dmbDoneModal .modal-dialog {
        width: 100%;
        max-width: 980px;
        margin: 0;
    }
    #dmbDoneModal .modal-content {
        max-height: calc(100vh - 24px);
        overflow: auto;
    }
    .dmb-confirm-check {
        opacity: 1 !important;
        position: static !important;
        -webkit-appearance: checkbox !important;
        appearance: checkbox !important;
        display: inline-block !important;
        width: 16px;
        height: 16px;
        margin: 0 6px 0 0 !important;
        vertical-align: top;
    }
    .dmb-confirm-wrap {
        display: flex;
        align-items: center;
        gap: 0px;
        margin: 0 0 10px;
    }
    .dmb-confirm-wrap label {
        margin: 0;
        font-weight: normal;
        cursor: pointer;
        line-height: 1.4;
    }
    .dmb-confirm-wrap input[type="checkbox"] {
        flex: 0 0 auto;
        margin-top: 0 !important;
    }
    .dmb-download-status svg {
        display: block;
        width: 16px;
        height: 16px;
    }
    .dmb-start-icon {
        width: 14px;
        height: 14px;
        margin-right: 6px;
        vertical-align: -2px;
    }
</style>
{% endblock %}

{% block javascript %}
<script>
$(function () {
    const $overlay = $('#dmbProgressOverlay');
    const $bar = $('#dmbProgressBar');
    const $text = $('#dmbProgressText');
    const $percent = $('#dmbProgressPercent');
    const $form = $('#dmbBackupForm');
    const $submit = $('#dmbSubmitBtn');
    const $doneModal = $('#dmbDoneModal');
    const $doneBodyText = $('#dmbDoneBodyText');
    const $doneDownloadList = $('#dmbDoneDownloadList');
    const $doneScannerBtn = $('#dmbDoneScannerBtn');
    const $doneCloseBtn = $('#dmbDoneCloseBtn');
    const $doneConfirmCheck = $('#dmbDoneConfirmCheck');
    const $doneConfirmLabel = $('#dmbDoneConfirmLabel');
    const $precheckWarning = $('#dmbPrecheckWarning');
    const $precheckBody = $('#dmbPrecheckBody');
    const $estimateLabel = $('#dmbEstimateLabel');
    const $requiredLabel = $('#dmbRequiredLabel');
    const precheckUrl = '{{ url('data_migration_backup_admin_precheck') }}';
    const scannerPresetBaseUrl = '{{ url('data_migration_backup_admin_scanner') }}';
    let precheckTimer = null;
    let precheckXhr = null;
    let timer = null;
    let progress = 0;
    let progressStartedAt = 0;
    const minProgressDurationMs = 2000;

    if ($overlay.length > 0 && !$overlay.parent().is('body')) {
        $overlay.appendTo(document.body);
    }
    if ($doneModal.length > 0 && !$doneModal.parent().is('body')) {
        $doneModal.appendTo(document.body);
    }

    function shouldDisableSubmit() {
        return false;
    }

    function syncSubmitState() {
        $submit.prop('disabled', shouldDisableSubmit());
    }

    function setProgress(value) {
        progress = Math.max(0, Math.min(100, value));
        $bar.css('width', progress + '%').attr('aria-valuenow', progress);
        $percent.text(progress + '%');
    }

    function startProgress() {
        if (timer) {
            clearInterval(timer);
            timer = null;
        }
        progressStartedAt = Date.now();
        setProgress(3);
        $overlay.css('display', 'flex');
        $text.text('{{ 'data_migration_backup.admin.progress.note'|trans|e('js') }}');

        timer = setInterval(function () {
            if (progress < 70) {
                setProgress(progress + Math.max(2, Math.floor(Math.random() * 5)));
            } else if (progress < 95) {
                setProgress(progress + 1);
            }
        }, 450);
    }

    function stopProgress() {
        if (timer) {
            clearInterval(timer);
            timer = null;
        }
    }

    function finishProgress() {
        stopProgress();
        setProgress(100);
    }

    function hideProgress() {
        stopProgress();
        $overlay.hide();
    }

    function waitMinimumProgressDuration(callback) {
        const elapsed = progressStartedAt > 0 ? (Date.now() - progressStartedAt) : 0;
        const waitMs = Math.max(0, minProgressDurationMs - elapsed);
        setTimeout(function () {
            if (typeof callback === 'function') {
                callback();
            }
        }, waitMs);
    }

    function extractErrorMessage(xhr) {
        if (xhr && xhr.responseJSON && xhr.responseJSON.message) {
            return xhr.responseJSON.message;
        }

        return '{{ 'data_migration_backup.admin.message.failed'|trans|e('js') }}';
    }

    function formatFileSize(bytes) {
        const mb = Math.max(0, Number(bytes || 0)) / 1024 / 1024;
        if (mb > 1000) {
            return Math.ceil(mb / 1024) + ' GB';
        }

        return Math.ceil(mb) + ' MB';
    }

    function escapeHtml(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function renderPrecheck(precheck) {
        const info = precheck || {};
        const estimateBytes = Number(info.estimated_bytes || 0);
        const requiredBytes = Number(info.required_bytes || 0);
        $estimateLabel.text(formatFileSize(estimateBytes));
        $requiredLabel.text(formatFileSize(requiredBytes));

        const hasWarning = Boolean(info.has_warning);
        $precheckWarning.toggle(hasWarning);

        const rows = Array.isArray(info.rows) ? info.rows : [];
        let html = '';
        rows.forEach(function (row) {
            const ok = Boolean(row.ok);
            html += '<tr>';
            html += '<td>' + escapeHtml(row.label || '') + '</td>';
            html += '<td>' + escapeHtml(row.value || '') + '</td>';
            html += '<td>' + (ok
                ? '<span class="dmb-label-status dmb-label-status-success">OK</span>'
                : '<span class="dmb-label-status dmb-label-status-warning">要確認</span>') + '</td>';
            html += '</tr>';
        });
        $precheckBody.html(html);
    }

    function schedulePrecheckRefresh() {
        if (precheckTimer) {
            clearTimeout(precheckTimer);
            precheckTimer = null;
        }
        precheckTimer = setTimeout(function () {
            if (precheckXhr && precheckXhr.readyState !== 4) {
                precheckXhr.abort();
            }
            precheckXhr = $.ajax({
                url: precheckUrl,
                method: 'POST',
                dataType: 'json',
                data: $form.serialize()
            }).done(function (res) {
                if (!res || !res.success) {
                    return;
                }
                renderPrecheck(res.precheck || {});
            });
        }, 250);
    }

    function renderDoneDownloads(downloads, profile) {
        const rows = Array.isArray(downloads) ? downloads : [];
        const backupRow = profile === 'migrate_default'
            ? rows.find(function (row) {
                return String(row.kind || '') === 'backup' && String(row.name || '') !== '';
            })
            : null;
        const scannerPresetUrl = backupRow
            ? (scannerPresetBaseUrl + '?preset_backup_name=' + encodeURIComponent(String(backupRow.name || '')))
            : '';

        $doneBodyText.text('バックアップが完了しました。次に、以下の3ファイルをダウンロードして互換スキャンを開始してください。「このバックアップで事前診断」をクリックすると互換スキャンを実行できます。');

        $doneDownloadList.empty();
        rows.forEach(function (row) {
            const name = String(row.name || '');
            if (!name) {
                return;
            }
            const sizeLabel = formatFileSize(row.size || 0);
            const destination = String(row.destination || '');
            const item = $('<div class="dmb-download-item"></div>');
            const actions = $('<div class="dmb-download-actions"></div>');
            const leftWrap = $('<div class="dmb-download-main"></div>');
            const status = $('<span class="dmb-download-status" aria-hidden="true"></span>');
            status.html(
                '<svg class="dmb-download-success-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" focusable="false" aria-hidden="true">' +
                '<circle cx="10" cy="10" r="10" fill="#16a34a"></circle>' +
                '<path d="M8.2 13.4L4.7 9.9l1.4-1.4 2.1 2.1 5.7-5.7 1.4 1.4-7.1 7.1z" fill="#ffffff"></path>' +
                '</svg>'
            );
            const left = $('<div></div>');
            const title = $('<div class="dmb-download-title"></div>');
            title.append(status);
            title.append($('<span class="dmb-download-name"></span>').text(name + ' (' + sizeLabel + ')'));
            left.append(title);
            if (destination) {
                left.append($('<div class="small text-muted"></div>').text(destination));
            }
            leftWrap.append(left);
            const button = $('<button type="button" class="btn btn-primary btn-xs"></button>');
            button.text('{{ 'data_migration_backup.admin.modal.download'|trans|e('js') }}');
            button.attr('data-url', String(row.download_url || ''));
            button.addClass('dmb-modal-download-btn');
            actions.append(button);
            item.append(actions).append(leftWrap);
            $doneDownloadList.append(item);
        });

        const total = rows.length > 0 ? rows.length : 3;
        if (total === 3) {
            $doneConfirmLabel.text('{{ 'data_migration_backup.admin.modal.confirm_three'|trans|e('js') }}');
        } else {
            $doneConfirmLabel.text('{{ 'data_migration_backup.admin.modal.confirm_generic'|trans|e('js') }}');
        }
        $doneConfirmCheck.prop('checked', false);
        $doneScannerBtn.attr('data-url', scannerPresetUrl);
        $doneScannerBtn.prop('disabled', true);
        $doneCloseBtn.prop('disabled', true);
    }

    function showDoneModal(downloads, profile) {
        hideProgress();
        renderDoneDownloads(downloads, profile);
        $doneModal.modal('show');
    }

    $doneModal.modal({
        backdrop: 'static',
        keyboard: false,
        show: false
    });

    $doneDownloadList.on('click', '.dmb-modal-download-btn', function () {
        const downloadUrl = String($(this).attr('data-url') || '');
        if (!downloadUrl) {
            return;
        }
        $(this).closest('.dmb-download-item').find('.dmb-download-status').addClass('is-done');
        const doneCount = $doneDownloadList.find('.dmb-download-status.is-done').length;
        const totalCount = $doneDownloadList.find('.dmb-download-item').length;
        const requiredCount = totalCount >= 3 ? 3 : totalCount;
        if (requiredCount > 0 && doneCount >= requiredCount) {
            $doneConfirmCheck.prop('checked', true).trigger('change');
        }
        const link = document.createElement('a');
        link.href = downloadUrl;
        link.setAttribute('download', '');
        link.style.display = 'none';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    });

    $doneConfirmCheck.on('change', function () {
        const checked = $(this).prop('checked');
        const scannerUrl = String($doneScannerBtn.attr('data-url') || '');
        $doneCloseBtn.prop('disabled', !checked);
        $doneScannerBtn.prop('disabled', !checked || scannerUrl === '');
    });

    $doneScannerBtn.on('click', function () {
        const scannerUrl = String($(this).attr('data-url') || '');
        if (scannerUrl === '' || $(this).prop('disabled')) {
            return;
        }
        window.location.href = scannerUrl;
    });

    $doneCloseBtn.on('click', function () {
        if (!$doneConfirmCheck.prop('checked')) {
            return;
        }
        $doneModal.modal('hide');
    });

    $form.on('submit', function (e) {
        e.preventDefault();
        if (shouldDisableSubmit()) {
            syncSubmitState();

            return;
        }

        startProgress();
        $submit.prop('disabled', true);

        $.ajax({
            url: $form.data('run-url'),
            method: 'POST',
            dataType: 'json',
            data: $form.serialize()
        }).done(function (res) {
            if (!res || !res.success) {
                waitMinimumProgressDuration(function () {
                    hideProgress();
                    syncSubmitState();
                    window.alert('{{ 'data_migration_backup.admin.message.failed'|trans|e('js') }}');
                });
                return;
            }

            waitMinimumProgressDuration(function () {
                finishProgress();
                $text.text('{{ 'data_migration_backup.admin.progress.done'|trans|e('js') }}');

                setTimeout(function () {
                    hideProgress();
                    syncSubmitState();
                    showDoneModal(res.downloads || [], String(res.backup_profile || 'custom'));
                }, 300);
            });
        }).fail(function (xhr) {
            waitMinimumProgressDuration(function () {
                hideProgress();
                syncSubmitState();
                window.alert(extractErrorMessage(xhr));
            });
        });
    });

    $form.on('change', 'input,select', function () {
        schedulePrecheckRefresh();
        syncSubmitState();
    });
    syncSubmitState();
    schedulePrecheckRefresh();
});
</script>
{% endblock %}

{% block main %}
{% set demo_runtime = app.request.attributes.get('demo_backup_runtime') %}
<div class="c-contentsArea__cols dmb-admin-screen">
    <div class="c-contentsArea__primaryCol">
        {% if demo_runtime is not empty and demo_runtime.master_reset is defined and demo_runtime.master_reset.visible|default(false) %}
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">{{ demo_runtime.master_reset_title|default('デモDBの初期化') }}</h3>
                </div>
                <div class="box-body">
                    {% if demo_runtime.master_reset.sql_configured|default(false) %}
                        <p class="small text-muted">{{ demo_runtime.master_reset_cooldown_note|default('実行後は一定時間の待機が必要です。') }}</p>
                        {% if demo_runtime.master_reset.last_reset_at %}
                            <p class="small text-muted">前回実行: {{ demo_runtime.master_reset.last_reset_at }}</p>
                        {% endif %}
                        {% if demo_runtime.master_reset.next_available_at %}
                            <p class="small text-muted">次回実行可能: {{ demo_runtime.master_reset.next_available_at }}</p>
                        {% endif %}
                        <form method="post" action="{{ url('demo_backup_admin_reset_default') }}">
                            <input type="hidden" name="_token" value="{{ token_value }}">
                            <button type="submit" class="btn btn-warning" {{ demo_runtime.master_reset.can_run_now|default(false) ? '' : 'disabled' }}>
                                {{ demo_runtime.master_reset_button_label|default('デモDBを初期状態に戻す') }}
                            </button>
                            {% if not (demo_runtime.master_reset.can_run_now|default(false)) %}
                                <div class="small text-muted mt-2">クールダウン中です。待機時間の終了後に実行できます。</div>
                            {% endif %}
                        </form>
                    {% else %}
                        <div class="alert alert-info" style="margin-bottom: 0;">
                            {{ demo_runtime.master_reset_missing_sql|default('初期化用SQLファイルが未設定です。ファイルを配置するとここから実行できます。') }}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}
        <form id="dmbBackupForm" method="post" data-run-url="{{ url('data_migration_backup_admin_run') }}">
            <input type="hidden" name="_token" value="{{ token_value }}">
            <input type="hidden" name="backup_profile" value="migrate_default">

            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">{{ 'data_migration_backup.admin.precheck.title'|trans }}</h3>
                </div>
                <div class="box-body">
                    <div class="small text-muted mb-2 dmb-estimate-summary" style="padding-bottom: 10px;">
                        {% set estimateMb = precheck.estimated_bytes > 0 ? (precheck.estimated_bytes / 1024 / 1024) : 0 %}
                        {% set requiredMb = precheck.required_bytes > 0 ? (precheck.required_bytes / 1024 / 1024) : 0 %}
                        {% set estimateLabel = estimateMb > 1000 ? ((estimateMb / 1024)|round(0, 'ceil') ~ ' GB') : (estimateMb|round(0, 'ceil') ~ ' MB') %}
                        {% set requiredLabel = requiredMb > 1000 ? ((requiredMb / 1024)|round(0, 'ceil') ~ ' GB') : (requiredMb|round(0, 'ceil') ~ ' MB') %}
                        {{ 'data_migration_backup.admin.precheck.estimate'|trans }}: <span id="dmbEstimateLabel">{{ estimateLabel }}</span> / {{ 'data_migration_backup.admin.precheck.required'|trans }}: <span id="dmbRequiredLabel">{{ requiredLabel }}</span>
                    </div>
                    <div id="dmbPrecheckWarning" class="mb-3 dmb-warning-inline" style="{{ precheck.has_warning ? '' : 'display:none;' }}"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i><span>{{ 'data_migration_backup.admin.message.precheck_ng'|trans }}</span></div>
                    <div class="table_list">
                        <div class="table-responsive with-border">
                            <table class="table table-striped mb-0">
                                <thead>
                                <tr>
                                    <th>{{ 'data_migration_backup.admin.precheck.item'|trans }}</th>
                                    <th>{{ 'data_migration_backup.admin.precheck.value'|trans }}</th>
                                    <th>{{ 'data_migration_backup.admin.precheck.status'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody id="dmbPrecheckBody">
                                {% for row in precheck.rows %}
                                    <tr>
                                        <td>{{ row.label }}</td>
                                        <td>{{ row.value }}</td>
                                        <td>
                                            {% if row.ok %}
                                                <span class="dmb-label-status dmb-label-status-success">OK</span>
                                            {% else %}
                                                <span class="dmb-label-status dmb-label-status-warning">要確認</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div style="margin-bottom: 20px;">
                <button id="dmbSubmitBtn" type="submit" class="btn btn-primary">
                    <svg class="dmb-start-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                        <circle cx="8" cy="8" r="7" fill="currentColor" opacity="0.2"></circle>
                        <path d="M6 4.8L11 8L6 11.2V4.8z" fill="currentColor"></path>
                    </svg>{{ 'data_migration_backup.admin.form.run'|trans }}
                </button>
            </div>
        </form>

    </div>
</div>

<div id="dmbProgressOverlay" class="dmb-progress-overlay">
    <div class="dmb-progress-panel">
        <div class="dmb-progress-title">{{ 'data_migration_backup.admin.progress.title'|trans }}</div>
        <div id="dmbProgressText" class="dmb-progress-note">{{ 'data_migration_backup.admin.progress.note'|trans }}</div>
        <div class="progress dmb-progress-wrap">
            <div id="dmbProgressBar" class="progress-bar bg-primary" role="progressbar" style="width:0%"></div>
            <span id="dmbProgressPercent" class="dmb-progress-percent">0%</span>
        </div>
        <div class="small text-danger" style="margin-top: 10px;">{{ 'data_migration_backup.admin.progress.warning'|trans }}</div>
    </div>
</div>

<div class="modal fade" id="dmbDoneModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">{{ 'data_migration_backup.admin.modal.title'|trans }}</h4>
            </div>
            <div class="modal-body">
                <p id="dmbDoneBodyText" style="margin-bottom: 15px;">バックアップが完了しました。次に、以下の3ファイルをダウンロードして互換スキャンを開始してください。「このバックアップで事前診断」をクリックすると互換スキャンを実行できます。</p>
                <div id="dmbDoneDownloadList"></div>
            </div>
            <div class="modal-footer">
                <div class="w-100">
                    <div class="dmb-confirm-wrap">
                        <input type="checkbox" id="dmbDoneConfirmCheck" class="dmb-confirm-check">
                        <label id="dmbDoneConfirmLabel" for="dmbDoneConfirmCheck" class="small">{{ 'data_migration_backup.admin.modal.confirm_three'|trans }}</label>
                    </div>
                    <div class="text-right">
                        <button type="button" class="btn btn-primary" id="dmbDoneScannerBtn" disabled>{{ 'data_migration_backup.admin.modal.to_scanner'|trans }}</button>
                        <button type="button" class="btn btn-default" id="dmbDoneCloseBtn" disabled>{{ 'data_migration_backup.admin.modal.close'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
