{% extends 'default_frame.twig' %}

{% block title %}{{ 'data_migration_backup.admin.nav.files'|trans }}{% endblock %}
{% block sub_title %}{{ 'data_migration_backup.admin.nav.title'|trans }}{% endblock %}
{% set menus = ['data_migration_backup', 'data_migration_backup_files'] %}

{% block stylesheet %}
<style>
    .dmb-admin-screen {
        font-size: 1.4rem;
        line-height: 1.6;
    }
    .dmb-admin-screen .box-header .box-title {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1.3;
    }
    .dmb-admin-screen .small,
    .dmb-admin-screen .btn,
    .dmb-admin-screen .form-control {
        font-size: 1.4rem;
    }
    .dmb-files-table thead th {
        font-size: 1.6rem !important;
        font-weight: 700 !important;
        line-height: 1.25;
    }
</style>
{% endblock %}

{% block main %}
<div class="row dmb-admin-screen">
    <div class="col-md-12">
        <div class="box">
            <div class="box-header">
                <h3 class="box-title">{{ 'data_migration_backup.admin.files.title'|trans }}</h3>
            </div>
            <div class="box-body">
                {% if backupFiles|length > 0 %}
                    <form class="text-right dmb-confirm-form" method="post" action="{{ url('data_migration_backup_admin_delete_all') }}" data-confirm="{{ 'data_migration_backup.admin.message.delete_all_confirm'|trans|e('html_attr') }}" style="margin-bottom: 15px;">
                        <input type="hidden" name="_token" value="{{ token_value }}">
                        <button type="submit" class="btn btn-danger btn-xs">
                            {{ 'data_migration_backup.admin.files.delete_all'|trans }}
                        </button>
                    </form>
                {% endif %}

                {% if backupFiles|length > 0 %}
                    <div class="table_list">
                        <div class="table-responsive with-border">
                            <table class="table table-striped dmb-files-table">
                                <thead>
                                <tr>
                                    <th>{{ 'data_migration_backup.admin.files.name'|trans }}</th>
                                    <th>{{ 'data_migration_backup.admin.files.type'|trans }}</th>
                                    <th>{{ 'data_migration_backup.admin.files.size'|trans }}</th>
                                    <th>{{ 'data_migration_backup.admin.files.date'|trans }}</th>
                                    <th class="text-right">{{ 'data_migration_backup.admin.files.action'|trans }}</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for file in backupFiles %}
                                    <tr>
                                        <td>{{ file.name }}</td>
                                        <td>{{ file.type_label }}</td>
                                        {% set fileMb = file.size > 0 ? (file.size / 1024 / 1024) : 0 %}
                                        <td>{{ fileMb > 1000 ? ((fileMb / 1024)|round(0, 'ceil') ~ ' GB') : (fileMb|round(0, 'ceil') ~ ' MB') }}</td>
                                        <td>{{ file.modified_at|date('Y-m-d H:i:s') }}</td>
                                        <td class="text-right">
                                            <a href="{{ url('data_migration_backup_admin_download_query') }}?name={{ file.name|url_encode }}" class="btn btn-default btn-xs">{{ 'data_migration_backup.admin.files.download'|trans }}</a>
                                            {% if file.restore_available %}
                                                <form class="dmb-confirm-form" style="display:inline;" method="post" action="{{ url('data_migration_backup_admin_restore', {name: file.name}) }}" data-confirm="{{ 'data_migration_backup.admin.message.restore_confirm'|trans|e('html_attr') }}">
                                                    <input type="hidden" name="_token" value="{{ token_value }}">
                                                    <button type="submit" class="btn btn-warning btn-xs">{{ 'data_migration_backup.admin.files.restore'|trans }}</button>
                                                </form>
                                            {% endif %}
                                            <form class="dmb-confirm-form" style="display:inline;" method="post" action="{{ url('data_migration_backup_admin_delete', {name: file.name}) }}" data-confirm="{{ 'data_migration_backup.admin.message.delete_confirm'|trans|e('html_attr') }}">
                                                <input type="hidden" name="_token" value="{{ token_value }}">
                                                <button type="submit" class="btn btn-danger btn-xs">{{ 'data_migration_backup.admin.files.delete'|trans }}</button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {% if pages > 1 %}
                        <div class="text-center">
                            <ul class="pagination" style="margin: 15px 0 0;">
                                <li class="{{ page <= 1 ? 'disabled' : '' }}">
                                    <a href="{{ page > 1 ? url('data_migration_backup_admin_files', {page: page - 1}) : '#' }}">前へ</a>
                                </li>
                                {% for p in 1..pages %}
                                    <li class="{{ p == page ? 'active' : '' }}">
                                        <a href="{{ url('data_migration_backup_admin_files', {page: p}) }}">{{ p }}</a>
                                    </li>
                                {% endfor %}
                                <li class="{{ page >= pages ? 'disabled' : '' }}">
                                    <a href="{{ page < pages ? url('data_migration_backup_admin_files', {page: page + 1}) : '#' }}">次へ</a>
                                </li>
                            </ul>
                        </div>
                    {% endif %}
                {% else %}
                    <p class="text-muted" style="margin-bottom: 0;">{{ 'data_migration_backup.admin.files.empty'|trans }}</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block modal %}
<div class="modal fade" id="dmbConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">確認</h4>
            </div>
            <div class="modal-body">
                <p id="dmbConfirmModalMessage" style="margin-bottom: 0;"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">キャンセル</button>
                <button type="button" class="btn btn-danger" id="dmbConfirmModalSubmit">実行する</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascript %}
<script>
$(function () {
    const $confirmModal = $('#dmbConfirmModal');
    const $confirmMessage = $('#dmbConfirmModalMessage');
    const $confirmSubmit = $('#dmbConfirmModalSubmit');
    let pendingForm = null;

    $(document).on('submit', '.dmb-confirm-form', function (e) {
        const $form = $(this);
        if ($form.data('confirmSubmitted') === true) {
            return;
        }

        e.preventDefault();
        const message = String($form.attr('data-confirm') || '');
        if (message === '') {
            return;
        }

        pendingForm = this;
        $confirmMessage.text(message);
        $confirmModal.modal('show');
    });

    $confirmSubmit.on('click', function () {
        if (!pendingForm) {
            $confirmModal.modal('hide');
            return;
        }

        const form = pendingForm;
        pendingForm = null;
        $(form).data('confirmSubmitted', true);
        $confirmModal.modal('hide');
        form.submit();
    });

    $confirmModal.on('hidden.bs.modal', function () {
        $confirmMessage.text('');
        pendingForm = null;
    });
});
</script>
{% endblock %}
