/**
 *
 *
 */
function SetHolder(){
    var kbn = $("input[name='Admin_SubContent_Edit[kbn]']:checked").val();
    var Flg = false ;

    if ( 1 == kbn){
        Flg = true;
        $('#metatag_area').hide();
        $('#Admin_SubContent_Edit_Config').hide().val('');
        $('#Admin_SubContent_Edit_holder').show();
        $('#PreviewBtn').show();

        switch( {{ eccube_config.Plugin_SubContent_prameter_parts }} ){
            case 2:
                SetDisabled('parameter',false);
                SetDisabled('holder',false);
                break;
            case 1:
                SetDisabled('parameter',true);
                SetDisabled('holder',false);
                break;
            default:
            case 0:
                SetDisabled('parameter',true);
                SetDisabled('holder',true);
            break;
        }
    }else{
        $('#metatag_area').show();
        $('#Admin_SubContent_Edit_Config').show();
        $('#Admin_SubContent_Edit_holder').hide();
        $('#PreviewBtn').hide();

    }

    SetRequirements();




}
function SetDisabled(name , Flg){
    var placeholder = Flg  ?  '使用できません' : '';
    
    $("#Admin_SubContent_Edit_" + name ).attr('disabled',Flg).prop('placeholder',placeholder);;
    if (Flg){
        $("#Admin_SubContent_Edit_" + name ).val('');
    }
}
function SetRequirements(){

    var Val = $('p#requirements').data('requirements');
    {#ページで  要件が設定されていない場合はパラメーターは使用できない#}
    if( 0 == $("input[name='Admin_SubContent_Edit[kbn]']:checked").val()){
        if(Val){
            SetDisabled('parameter',false);
        }else{
            SetDisabled('parameter',true);
        }
    }else{
        $('p#requirements').data('requirements','');
        Val = '';
    } 
    
  
  
    var html = Val ?  '正規表現 : ' + Val : '';
    $('#requirements').html(html);
}

//画像を表示する2022
function LoadImage(){

    var $form= $('#form02');
    var params =	$form.serialize();
    const $Images = $('#ImageBlock')
        .prop('disabled', true)
        .load('{{ url('admin_SubContent_image_load') }}', params, function () {
         	$(this).prop('disabled', false);
  
		});
}
</script>
{% endblock javascript %}



