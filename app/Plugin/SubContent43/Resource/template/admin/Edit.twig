{% block javascript %}

{#<script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>#}
<script>


    $(function(){
        {% if eccube_config.Plugin_SubContent_After_Regist and SubContent.id %}
            $("input[name='Admin_SubContent_Edit[kbn]'").each(function( value ) {		
                if('checked'!=$(this).attr('checked')){
                    $(this).prop('disabled', true);
                }
            });

            $('#Admin_SubContent_Edit_Config option').each(function( value ) {
                {% if  SubContent.Config is not null %}
                    if( {{SubContent.Config.id}} != $(this).val() ){
                        $(this).hide();
                }
                {% endif %}
            });

  
        {% endif %}

        SetHolder();

        const $dropArea = $('#upload-zone');

        //1 ドラッグした状態で要素内に入ったとき
        $dropArea.on('dragover', function(e) {
            // デフォルトの動作を止めて、要素のスタイルを変える
            e.stopPropagation();
            e.preventDefault();
            $dropArea.css('background', '#e1e7f0');
        });

        //2 ドラッグした状態で要素から出たとき
        $dropArea.on('dragleave', function(e) {
        // 要素のスタイルを元に戻す
        $dropArea.css('background', '#ffffff');
        });

        //3 ファイルが要素内でドロップされたとき
        $dropArea.on('drop', function(e) {
    
        // デフォルトの動作を止めて、要素のスタイルを元に戻す
        e.preventDefault();
        $dropArea.css('background', '#ffffff');
        // dataTrasnferプロパティからドロップされたファイルのFileListオブジェクトが取得できる
        const  files = e.originalEvent.dataTransfer.files;
        var form = new FormData($('#form_image').get(0)); 
            
           for(let i = 0; i < files.length;i++){

           form.append("Admin_SubContent_Edit[image_file][]", files[i]);

           };
        // fileUploadJQuery(formData);
        FileUploag(form);
        });

        //UPロードボタンを押したとき
        $('#Admin_SubContent_Edit_image_file').on('change', function (e) {
        formdata  = new FormData($('#form_image').get(0)); 
        FileUploag(formdata);
        });



        $("#Admin_SubContent_Edit_kbn").change(function(){
            SetHolder();
        });


        $("#Admin_SubContent_Edit_Config").change(function(){
                var ConfigId = $(this).val();

                $.ajax({
                        url: "{{ url('admin_SubContent_ConfigAjax')}}",
                        type: 'POST',
                        data: {ConfigId: ConfigId },
                        dataType: 'json'
                    }).done(function(data) {
                        if (data.status=='OK'){
                            $('p#requirements').data('requirements',data.requirements);
                        }
                    }).fail(function(jqXHR) {
                            alert('{{'SUbcontent.Admin.message03'|trans}}')
                    }).always(function(data) {
                        if (data.status=='OK'){
                            SetRequirements();
                        }     
                    });
            

            });

        $('div.ImageListThumbnail').dblclick(function (){
            let image  = $(this).data('image');
            let id     = $(this).data('id');
            var imge;
    
            if (0<id){
                img ='<img src="' + image + '" alt="">';
            }else{
                 //共通画像
                img ="<img src='" + image + "'" + ' alt="">';
            }
            let html= $('#Admin_SubContent_Edit_html').val();
                $('#Admin_SubContent_Edit_html').val(html + '\n'+img);
        });

    $('div.ImageListThumbnail a.remove-image').on("click", function() {
        if(!confirm('本当に削除しますか？ \n削除すると元にもどりません'))
            {
                return false;
            }     
            let Parent = $(this).parent('div.ImageListThumbnail');
            let FileName = Parent.data('image');

            $.ajax({
                url: "{{ url('admin_SubContent_image_remove')}}",
                    type: 'POST',
                    data: {image: FileName,id: '{{Id}}' },
                    dataType: 'json'
                    }).done(function(data) {
                        if (data.status=='OK'){
                            Parent.hide();
                            alert(data.image + '{{'SUbcontent.Admin.message01'|trans}}');
                        }
                    }).fail(function(data) {
                            alert('{{'SUbcontent.Admin.message02'|trans}}')
                    }).always(function(data) {
                        if (data.status=='OK'){}
                       

            });
        });

    });


function FileUploag(formdata){ 

   $.ajax({
        url  : '{{url('admin_SubContent_image_add') }}',
        type : "POST",
        data :  formdata,
        cache       : false,
        contentType : false,
        processData : false,
        dataType    : "json"
    })
    .done(function(data){
        if (data.status=='NG')
        {
             alert(data.message);  
        }
    })
    .fail(function(jqXHR){
         alert('{{'SUbcontent.Admin.Image_error10'|trans}}');
    })
    .always(function(data) {
        if (data.status=='OK'){
            alert('{{'SUbcontent.Admin.message00'|trans}}');
            window.location.href='{{ url('Plugin_Admin_SubContent_Edit',{'id': Id}) }}';
        }     
    });
}


