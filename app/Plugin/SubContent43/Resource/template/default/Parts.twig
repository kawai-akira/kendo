{% if SubContent.css is not null %}
    <style type="text/css">
	    {{ SubContent.css|raw }}
    </style>
{% endif %}
<section id="SubContent" class="SubContent_part">
    <div class="{{SC_Class(SubContent) }}" id="SubContent_part{{ SubContent.id}}">
    {% if titleFlg %}
    <h2>{{ SubContent.Title }}</h2> 
    {% endif %}
	{% if SubContent.html is not null %}
    	{{ SubContent.html|raw}}
	{% endif %}
    </div>
</section>