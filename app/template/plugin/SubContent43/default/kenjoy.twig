{% extends 'default_frame.twig' %}
{% set body_class = 'kenjoy_page' %}
{% block stylesheet %}
<style type="text/css">
#subcontent_area{
	margin-top: 155px;
}
{{ SubContent.css|raw }}
</style>
{% endblock stylesheet %}
{% block javascript %}
<script>
{{include('@SubContent43/js/Plugin_SubContent.js.twig') }}
{% if SubContent.Config is not null %}
{% if 1 == SubContent.Config.JsKbn %}
{{ SC_PageJs()|raw}}
{% endif %}
{% endif %}
</script>
{% endblock %}
{% block main %}
<div class="kenjoy_area" id="kenjoy_{{SubContent.parameter}}">
	{% if SubContent.Html is not null %}
			{{kenjoyDate(SubContent)|raw}}    
        	<h2>{{SubContent.title}}</h2>
			{{ SubContent.html|raw }}
	{% endif %}
</div>
{% endblock %}