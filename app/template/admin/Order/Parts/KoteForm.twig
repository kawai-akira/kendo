    <div class="size-area row" id="kote_area">
        <div class="size-box col-8">
            <p>{{'product_kote_title'|trans}}</p>
        </div>

        <div class="size-box col-4">
            <dl>
                <dt>{{'product_kote_etc'|trans}}</dt>
                <dd>
                    {{ form_widget(form.kote.kote_etc) }}
                    {{ form_errors(form.kote.kote_etc) }}
                </dd>
            </dl>
        </div>
        <div class="size-box col-2">
            <dl>
                <dt>{{'product_kote_size_left_d'|trans}}</dt>
                <dd class="input">
                    {{ form_widget(form.kote.kote_size_left_d) }}cm
                    {{ form_errors(form.kote.kote_size_left_d) }}
                </dd>
            </dl>
        </div>    
        <div class="size-box col-2">
            <dl>
                <dt>{{'product_kote_size_left_e'|trans}}
                <dd class="input">
                    {{ form_widget(form.kote.kote_size_left_e) }}cm
                    {{ form_errors(form.kote.kote_size_left_e) }}
                </dd>
            </dl>
        </div>    
        <div class="size-box col-2">
            <dl>
                <dt>{{'product_kote_size_left_f'|trans}}</dt>
                <dd class="input">
                    {{ form_widget(form.kote.kote_size_left_f) }}cm
                    {{ form_errors(form.kote.kote_size_left_f) }}
                </dd>
            </dl>
        </div>    
        <div class="size-box col-2">
            <dl>
                <dt>{{'product_kote_size_right_d'|trans}}</dt>
                <dd class="input">
                    {{ form_widget(form.kote.kote_size_right_d) }}cm
                    {{ form_errors(form.kote.kote_size_right_d) }}
                </dd>
            </dl>
        </div>    
        <div class="size-box col-2">
            <dl>
                <dt>{{'product_kote_size_right_e'|trans}}
                <dd class="input">
                    {{ form_widget(form.kote.kote_size_right_e) }}cm
                    {{ form_errors(form.kote.kote_size_right_e) }}
                </dd>
            </dl>
        </div>    
        <div class="size-box col-2">
            <dl>
                <dt>{{'product_kote_size_right_f'|trans}}</dt>
                <dd class="input">
                    {{ form_widget(form.kote.kote_size_right_f) }}cm
                    {{ form_errors(form.kote.kote_size_right_f) }}
                </dd>
            </dl>
        </div>    

   </div>


