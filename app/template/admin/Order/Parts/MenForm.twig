<div class="size-area row">
    <div class="size-box col-12">
        <p>{{'product_men_title'|trans}}</p>
    </div>
    <div class="size-box col-3">
        <dl>
            <dt>{{'product_men_size_a'|trans}}</dt>
            <dd class="input">
                {{ form_widget(form.men.men_size_a) }}cm
                {{ form_errors(form.men.men_size_a) }}
            </dd>
        </dl>
    </div>    
    <div class="size-box col-3">
        <dl>
            <dt>{{'product_men_size_b'|trans}}</dt>
            <dd class="input">
                {{ form_widget(form.men.men_size_b) }}cm
                {{ form_errors(form.men.men_size_b) }}
            </dd>
            </dl>
    </div>  
    <div class="size-box col-3">
        <dl>
            <dt>{{'product_men_size_c'|trans}}</dt>
            <dd class="input">
                {{ form_widget(form.men.men_size_c) }}cm
                {{ form_errors(form.men.men_size_c) }}
            </dd>
        </dl>
    </div>
    <div class="size-box col-3">
        <dl>
            <dt>{{'product_men_etc'|trans}}</dt>
            <dd>
                {{ form_widget(form.men.men_etc) }}
                {{ form_errors(form.men.men_etc) }}
            </dd>
        </dl>    
    </div>
</div>
