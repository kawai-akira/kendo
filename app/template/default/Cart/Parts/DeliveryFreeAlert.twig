<div class="ec-cartRole_FreeAlert text-left">
    <strong>{{Shop.ShopName }}</strong>
    {% if Amount >= Shop.deliveryFreeAmount %}
        {{ '現在送料無料です。'|trans }}
    {% else %}
        {% set Price = Shop.deliveryFreeAmount - Amount %}
        あと「<strong>{{Price|price}}</strong>」のお買い上げで<strong class="ec-color-red">送料無料</strong>になります。
    {% endif %}
</div>    
<div class="ec-cartRole__total text-right">
    {{ '合計：'|trans }}<span class="ec-cartRole__totalAmount">{{ Amount|price }}</span>
</div>
