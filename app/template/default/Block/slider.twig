 <style>
        .ec-sliderRole{
            max-width:1400px!important ;
            padding-left:0;
            padding-right:0;
        }
        .ec-sliderRole .slick-slider {
            margin-bottom: 30px;
        }

        .slick-dots {
            position: absolute;
            bottom: -45px;
            display: block;
            width: 100%;
            padding: 0;
            list-style: none;
            text-align: center;
        }

        .slick-dots li {
            position: relative;
            display: inline-block;
            width: 20px;
            height: 20px;
            margin: 0 5px;
            padding: 0;

            cursor: pointer;
        }

        .slick-dots li button {
            font-size: 0;
            line-height: 0;
            display: block;
            width: 20px;
            height: 20px;
            padding: 5px;
            cursor: pointer;
            color: transparent;
            border: 0;
            outline: none;
            background: transparent;
        }
{#
        .slick-dots li button:hover,
        .slick-dots li button:focus {
            outline: none;
        }

        .slick-dots li button:hover:before,
        .slick-dots li button:focus:before {
            opacity: 1;
        }

        .slick-dots li button:before {
            content: " ";
            line-height: 20px;
            position: absolute;
            top: 0;
            left: 0;
            width: 12px;
            height: 12px;
            text-align: center;
            opacity: .25;
            background-color: black;
            border-radius: 50%;

        }

        .slick-dots li.slick-active button:before {
            opacity: .75;
            background-color: black;
        }

        .slick-dots li button.thumbnail img {
            width: 0px;
            height:0px;
        }
    #}
        .slick-prev, .slick-next {
             z-index: 10; /* 画像の後ろに隠れないように前面に出す */
            width: 40px;
             height: 40px;
             color:#333;
        }
    
        .slick-prev {
             left: 20px !important;
        }
        .slick-next {
            right: 20px !important;
        }
        .slick-prev:before, .slick-next:before {
            font-size: 30px !important; /* 矢印を少し大きく */
            color: #000000 !important;   /* 矢印の色を「黒」に変更（目立つ色に変えてもOK） */
            opacity: 0.7;               /* 少し透明度を入れる */
        }
{#        
        .slick-prev:before, .slick-next:before {
             content: '' !important;
        }
        .custom-arrow { 
            font-size: 24px !important; /* 文字の大きさ */
            color: #333333 !important;  /* 文字の色 */
            font-weight: bold;          /* 太字にする */
        }
#}
/* マウスを乗せたとき */
.slick-prev:hover:before, .slick-next:hover:before {
  opacity: 1;
}
        .ec-sliderRole .item {
            max-width:1400px!important;
        }
        .item img {
            width:100%;
            height:500px;
        }


    </style>
