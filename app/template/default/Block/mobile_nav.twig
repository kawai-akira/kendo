<div class="ec-headerRole__navSP">
    <div class="ec-headerNavSP ">
        <img src="{{ asset('assets/img/common/bars.png' ,'user_data')}}" alt="開く">
    </div>
    <div class="ec-drawerRoleClose">
            <img src="{{ asset('assets/img/common/close.png' ,'user_data')}}" alt="閉じる">
    </div>
</div>
<div class="movile_nav_header">
    <div class="head">
        {% if is_granted('ROLE_USER') %}
            <div class="item">
                <a href="{{ url('mypage') }}">
                    <img src="{{ asset('assets/img/common/mypage.png', 'user_data')}}" alt="マイページ">
                    <span class="ec-headerNav__itemLink">{{ 'マイページ'|trans }}</span>
                </a>
            </div>
            <div class="item logout">
                <a href="{{ url('logout') }}">
                    {#<i class="ec-headerNav__itemIcon fas fa-lock fa-fw"></i> #}
                    <img src="{{ asset('assets/img/common/logout.png', 'user_data')}}" alt="新規会員登録">
                    <span class="ec-headerNav__itemLink">{{ 'ログアウト'|trans }}</span>
                </a>
            </div>
        {% else %}
        <div class="item entry">
            <a href="{{ url('entry') }}">
                {#<i class="ec-headerNav__itemIcon fas fa-user fa-fw"></i>#}
                <img src="{{ asset('assets/img/common/entry.png', 'user_data')}}" alt="新規会員登録">
                <span class="ec-headerNav__itemLink">{{ '新規会員登録'|trans }}</span>
            </a>
        </div>
        <div class="item">
            <a href="{{ url('mypage_login') }}">
                {#<i class="ec-headerNav__itemIcon fas fa-lock fa-fw"></i>#}
                <img src="{{ asset('assets/img/common/login.png', 'user_data')}}" alt="ログイン">
                <span class="ec-headerNav__itemLink">{{ 'ログイン'|trans }}</span>
            </a>
        </div>
        {% endif %}
        {% if BaseInfo.option_favorite_product %}
            <div class="item favorite">
                <a href="{{ url('mypage_favorite') }}">
                <img src="{{ asset('assets/img/common/favorite.png', 'user_data')}}" alt="お気に入り">
                {#    <i class="ec-headerNav__itemIcon fas fa-heart fa-fw"></i>#}
                    <span class="ec-headerNav__itemLink">{{ 'お気に入り'|trans }}</span>
                </a>
            </div>
        {% endif %}
    </div>
</div>

