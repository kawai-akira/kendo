<script>

$(function(){
    $('#searchProductCst #Shop').change(function(){
        var id = $(this).val();
        $('#searchProductCst button').prop('disabled', true);
        const $Category = $('#searchProductCst .category')								
            .prop('disabled', true)								
            .load('{{ url('block_search_category_load')}}'+'?Shop=' + id ,'' , function() {								
                $(this).prop('disabled', false);								
            });
        const $tag = $('#searchProductCst .tag')								
            .prop('disabled', true)								
            .load('{{ url('block_search_tag_load')}}'+'?Shop=' + id ,'' , function() {								
                $(this).prop('disabled', false);								
                $('#searchProductCst button').prop('disabled', false);
            
            });
    });    							
  });
</script>
<div id="searchProductCst" class="">
    <div class="search" >
        <form method="get" id="searchformCst" action="{{ path('product_list') }}">
            <div class="search_inner">
                <div class="Shop">
                    <p>武道具店から選ぶ</p>
                        {{ form_widget(formCst.Shop) }}
                </div>
                <div class="category">
                    <p>{{'front_search_product_category'|trans}}</p>
                    {{ form_widget(formCst.category_id ,{'id': null, 'attr': {'class': 'form-select'}}) }}
                </div>
                <div class="tag">
                    <p>{{'front_search_product_tag'|trans}}</p>
                    {{ form_widget(formCst.Tag,{'attr': {'class': 'form-select'}}) }}
                </div>
                <div>
                <div class="price_area ec-input">
                    <p>キーワードを入力</p>
                       {{ form_widget(formCst.name) }}
                    <div class="search_price">
                        <p>価格</p>
                        {{ form_widget(formCst.min) }}円 ～{{ form_widget(formCst.max) }}円
                    </div>
                </div>    
                <div class="mt-4 text-center" >  
                    <button type="submit" class="btn btn-secondary">検索</button>
                </div>
            </div>    
        </form>
    </div>
</div>