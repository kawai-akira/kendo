 <div class="category_img mt-3" >
   {% if 'category' == flg %}
    {% if Shop is not null %}<h2>{{Shop.ShopName}}の{{ Category.name }}</h2>{% endif %}
    <img src="{{asset(image,'user_data')}}" alt="{{ Category.name }}">
   {% endif %}
   {% if 'shop' == flg %}
      <img src="{{asset(Shop.shopImage,'save_image')}}" alt="{{ Shop.shop_name }}"/>
      <h2>{{Shop.ShopName}}</h2>
      <div>{{Shop.appeal|nl2br}}</div>
   {% endif %}
 </div>