<div class="size-area" id="sex">
    <div class="size-box">
        <dl class="sex_size">
            <dt>
                {{'product_common_sex'|trans}}
                <span class="required">必須</span>
            </dt>
            <dd class="radio">
                {{ form_widget(form.sex.sex ,{'label_attr': {'class': 'radio-inline'}}) }}
                {{ form_errors(form.sex.sex) }}
            </dd>
         </dl>    
    </div>
</div>
