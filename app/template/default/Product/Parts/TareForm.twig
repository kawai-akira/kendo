<div class="size-area row">
    <div class="size-box col-7">
        <h2>{{'product_tare_title'|trans}}</h2>
        <dl class="tare_size">
            <dt>{{'product_tare_size_waist'|trans}}</dt>
            <dd class="input">
                {{ form_widget(form.tare.tare_size_waist) }}cm
                {{ form_errors(form.tare.tare_size_waist) }}
            </dd>
            <dt>{{'product_tare_etc'|trans}}</dt>
            <dd>
                {{ form_widget(form.tare.tare_etc) }}
                {{ form_errors(form.tare.tare_etc) }}
            </dd>
        </dl>    
    </div>
    <div class="col-5">
    </div>
 </div>


