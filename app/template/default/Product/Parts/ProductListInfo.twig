<style>
#product_list_info_area{
    max-width: 1400px;
    margin: 0 auto;
}
#product_list_info_area h2.header-line01{
   font-size: 20px;
   border-bottom: 1px solid #222;
   padding-bottom: 15px;
   margin-bottom: 25px;
}
#product_list_info_area h3{
   font-size: 16px;
}
#product_list_info_area p {
    margin-top: 5px;
    margin-bottom: 5px;
}
#product_list_info_area .link a{
    color: #910404;
    font-weight: bold;
}

</style>
<div id="product_list_info_area" >
{% if 'category'==Flg %}
   <div class="category_info">
      <h2 class="header-line01">{{Info.title}}</h2>
      {{ Info.html|raw}}
   <div>
{% endif %}
{% if 'shop' == Flg %}
      <div class="shop_info">
         <h2 class="header-line01">{{Shop.ShopName}}</h2>
            <div class="info mb-5">
                {{ SC_PartsId(Shop.id,true)|raw }}
            </div>
         
            
            {% if 1 == urlFlg %}
               <div class="link">
                  <a href="{{ Shop.ShopUrl}}" target="_blank">{{Shop.ShopName}}</a> 
               </div>
            {% elseif 2 == urlFlg and SubContent is not null %}
               <div class="link">
                  <a href="{{url('Plugin_SubContent_Kenjoy',{'cd': Shop.ShopUrl })}}" target="_blank">
                     <p>▼{{Shop.ShopName}}のインタビュー記事へ！！ ▼</p>
                      <span>{{SubContent.Title}}</span>
                  </a> 
               </div>
            {% endif %}
      <div>
{% endif %}  
</div>